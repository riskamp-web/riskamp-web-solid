+// PATCH (riskamp-web-solid): route stylesheets, keyed by href. each one is
+// linked in <head> once and never removed, so it's fetched once. it's switched
+// on (media=all) while at least one route using it is mounted, and off
+// (media="not all") otherwise. that keeps upstream's behaviour of unmounting a
+// route's css when the route unmounts, which matters for the few global
+// (non-module) stylesheets route chunks import. flipping `media` applies
+// synchronously, with no refetch and no flash.
+const routeSheets = new Map();
+function loadRouteStyles(styles) {
+    return Promise.all(styles.map((style) => {
+        const href = style.attrs.href;
+        if (!href)
+            return;
+        let sheet = routeSheets.get(href);
+        if (!sheet) {
+            // already linked by the html shell: always on, nothing to manage
+            if (document.head.querySelector(`link[rel="stylesheet"][href="${href}"]`))
+                return;
+            const link = document.createElement("link");
+            link.rel = "stylesheet";
+            link.href = href;
+            link.media = "not all"; // loads, but doesn't apply until retained
+            // resolve on error too: a failed sheet shouldn't hang the route
+            const ready = new Promise((resolve) => {
+                link.addEventListener("load", resolve, { once: true });
+                link.addEventListener("error", resolve, { once: true });
+            });
+            document.head.appendChild(link);
+            sheet = { link, ready, refs: 0 };
+            routeSheets.set(href, sheet);
+        }
+        return sheet.ready;
+    }));
